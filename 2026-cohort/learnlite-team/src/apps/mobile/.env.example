# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.
# A full URL, or dev:8000 for the local dev server on this computer (found automatically).
EXPO_PUBLIC_API_URL=https://your-api-host
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
