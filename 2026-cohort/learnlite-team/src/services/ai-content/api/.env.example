# Copy to .env for local runs. Never commit .env. On Cloud Run use Secret Manager.

# Where this runs: local | test | staging | production  (unset = production)
# AUTH_MODE=dev and LEARNLITE_MOCK only work with local or test, and never on Cloud Run.
APP_ENV=local

# Drafting (Gemini). Option A: Vertex AI (Cloud Run, no key needed)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# Option B: API key (local only)
# GEMINI_API_KEY=

# Checking (Nemotron). On Cloud Run mount from Secret Manager.
# NVIDIA_API_KEY=

# Storage: memory (local) or firestore
DRAFT_STORE=memory
AI_DRAFTS_COLLECTION=aiContentDrafts

# Local testing only: X-Dev-User header login and fake AI responses
AUTH_MODE=dev
LEARNLITE_MOCK=1

# Comma-separated origins allowed to call the standalone service
CORS_ORIGINS=http://localhost:8081
