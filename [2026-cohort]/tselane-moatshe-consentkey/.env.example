# ConsentKey environment variables.
#
# For LOCAL docker-compose you do NOT need this file — the emulator is wired
# automatically in docker-compose.yml. Copy this to `.env` only when you are
# ready to point at real/production Firestore.

# --- Real / production Firestore ---
# When these are set (and FIRESTORE_EMULATOR_HOST is NOT), the app talks to real
# Firestore. Mount your service-account key into the container and point to it.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firestore-key.json

# --- App ---
PORT=3000
HOSTNAME=0.0.0.0

# --- NVIDIA NIM (free-text message -> draft consent request) ---
# Get a key from the NVIDIA API catalog (build.nvidia.com). Read on the server
# only; it is never sent to the browser. Leave it unset and the draft panel is
# simply not offered — the rest of the app works exactly the same.
# Every contributor needs their own free key. Put it in your local .env only.
NIM_API_KEY=
# Model id. Thinking mode is switched off in the request.
NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional: how long to wait for NVIDIA before giving up, in milliseconds (default 15000).
# NIM_TIMEOUT_MS=15000
# The older names NVIDIA_API_KEY and NVIDIA_MODEL still work as fallbacks, but
# NIM_API_KEY and NIM_MODEL win when both are set. Never commit a real key.
#
# PIN for the seeded demo users (the four demo parents and two demo staff).
# DEMO ONLY: they all share it. 4 to 8 digits; default {DEMO_PIN}. Change it, or set
# CONSENTKEY_SEED_DEMO=false to not create the demo users at all.
# CONSENTKEY_DEMO_PIN=[DEMO PIN]
# Optional: OpenAI-compatible base URL. Defaults to the hosted NVIDIA API
# catalog; point it at a self-hosted NIM container to run without the
# hosted service.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- PIN lockout (policy PENDING team agreement: 5 tries / 5 min today; Thando's document says 3) ---
# PIN_MAX_ATTEMPTS=5
# PIN_LOCK_MINUTES=5

# --- School calendar and escalation (plan phase 2; assumptions A-01, A-02) ---
# Working days are Monday to Friday. South African public holidays are always
# excluded (computed in code). List EXTRA non-working dates as YYYY-MM-DD,
# comma-separated (school closure days, holidays declared by proclamation).
# SCHOOL_HOLIDAYS=2026-12-16,2026-12-25
# Who an overdue request is escalated to (S-01 or S-02). Unset means the other
# staff role. Escalation is visibility only: the request stays pending and is
# never auto-approved.
# ESCALATION_RECIPIENT=S-02

# --- Medical restriction deadline (plan phase 3; assumption A-05) ---
# Calendar days S-02 has to finish restricting a withdrawn medical note.
# Defaults to 7 when unset. Restricting keeps the note; it does not delete it.
# MEDICAL_RESTRICTION_DAYS=7

# --- Audit retention (OD-06) ---
# How many months to keep an audit entry. There is deliberately NO default:
# the period is a legal decision that is still open, and inventing one would
# be worse than leaving it unset. While unset, every entry records
# retainUntil: null ("not decided"), and nothing can ever expire.
# AUDIT_RETENTION_MONTHS=24

# --- Users and System Admin ---
# The default System Admin is created on first start. Username defaults to
# "admin". The PIN (4 to 8 digits) MUST be set outside development: if
# NODE_ENV=production and this is unset, the admin is NOT created and an error
# is logged. In development only, an unset PIN falls back to [ADMIN PIN] so
# `npm run dev` works with no setup. The PIN is stored hashed and is only used
# when the admin account does not exist yet; change it later from the admin
# page (Reset PIN), not here.
# CONSENTKEY_ADMIN_USER=admin
# CONSENTKEY_ADMIN_PIN=
# Set to false to skip creating the demo users (recommended for real use).
# CONSENTKEY_SEED_DEMO=true
# Set to true when the site is served over HTTPS, so the session cookie is
# only sent over HTTPS. Leave unset for plain http://localhost.
# CONSENTKEY_SECURE_COOKIE=false
