{
  "name": "consentkey",
  "version": "0.2.0",
  "private": true,
  "description": "ConsentKey: parent consent dashboard (Next.js) over the integration layer — three simulated systems, consent-change connector, task completion history and an append-only audit log. Firestore-backed persistence (emulator now, real Firestore via env later).",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test test/**/*.test.ts",
    "demo": "tsx src/demo.ts",
    "dashboard": "tsx src/dashboard.ts",
    "typecheck": "tsc --noEmit",
    "test:rules": "node --import tsx --test test/firestoreRules.test.ts"
  },
  "keywords": [
    "consent",
    "sdg16",
    "integration",
    "nextjs"
  ],
  "author": "Manoj Kasula",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase": "^13.4.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
