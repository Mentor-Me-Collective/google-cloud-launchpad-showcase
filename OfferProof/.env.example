# OfferProof Environment Configuration Template
# Copy this file to .env for local development. Never commit .env to source control.

# -----------------------------------------------------------------------------
# Supabase Configuration (Frontend & SSR Server)
# -----------------------------------------------------------------------------
# Your Supabase project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable / anon API key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# -----------------------------------------------------------------------------
# Supabase Edge Functions Secrets
# Configure these using `supabase secrets set` or the Supabase project dashboard.
# They are executed inside Deno on Supabase and must NOT be placed in client code.
# -----------------------------------------------------------------------------
# NVIDIA Inference API Key for Nemotron-3.5 AI recommendations
# Set via: supabase secrets set NVIDIA_API_KEY="nvapi-..."
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# Google Cloud Service Account JSON for BigQuery threat analytics
# Required permissions: roles/bigquery.dataViewer, roles/bigquery.jobUser
# Set via: supabase secrets set GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-gcp-project","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"sa@your-gcp-project.iam.gserviceaccount.com"}

